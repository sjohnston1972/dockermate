# Copy to .env and fill in. Never commit .env.

# OpenAI — used by the dockermate chatbot.
OPENAI_API_KEY=sk-...
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional — only needed if you want the assistant to manage Cloudflare from
# inside the container (the initial setup uses these from your shell).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- Server-side auth (defense-in-depth, see README "Security") ---
#
# dockermate has NO built-in bypass: if neither option below is configured,
# the server FAILS CLOSED — it refuses every /api/* request (except
# /api/health) and logs a loud warning at startup. Configure at least one
# before deploying.
#
# Option A — verify the Cloudflare Access JWT at the origin. Set BOTH to
# enable this mode.
#   ACCESS_TEAM_DOMAIN — your Access team domain, e.g. myteam.cloudflareaccess.com
#   ACCESS_AUD         — the Access application's AUD tag (Access app > Overview)
# ACCESS_TEAM_DOMAIN=
# ACCESS_AUD=
#
# Option B — a shared-secret bearer token, for deployments not fronted by
# Cloudflare Access (e.g. the standalone `ports: ["8095:8080"]` mode). The
# dockermate web UI prompts for this once and remembers it in the browser
# (localStorage), sending it as `Authorization: Bearer <value>`.
#   APP_SHARED_SECRET — any long random string
# APP_SHARED_SECRET=
#
# Both may be configured together — a request is allowed through if it
# satisfies either check.

# --- Chatbot guardrails (see README "Chatbot guardrails") ---------------

# exec_in_container runs an arbitrary shell command inside any running
# container. Combined with the mounted Docker socket, that is root-equivalent
# on the host. It is OFF by default — the tool is not even offered to the
# model — and only usable once you deliberately opt in here.
CHAT_ALLOW_EXEC=false

# Optional, only used when CHAT_ALLOW_EXEC=true. Comma-separated list of
# container names exec is permitted against. Leave unset to allow any
# running container once exec is enabled.
# CHAT_EXEC_CONTAINER_ALLOWLIST=nginx,librechat

# Optional, only used when CHAT_ALLOW_EXEC=true. Comma-separated list of
# exact commands / command prefixes exec is permitted to run (matched
# against the full command string). Leave unset to allow any command once
# exec is enabled.
# CHAT_EXEC_COMMAND_ALLOWLIST=ls,cat /app/log

# Optional. Every mutating chatbot tool call (proposed, confirmed, blocked,
# or cancelled) is always logged to stdout as a [chat-audit] JSON line. Set
# this to also append that JSON line to a file.
# CHAT_AUDIT_LOG_FILE=/data/dockermate-chat-audit.log
