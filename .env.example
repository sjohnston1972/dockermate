# Copy to .env and fill in. Never commit .env.

# OpenAI — used by the dockermate chatbot.
OPENAI_API_KEY=sk-...
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional — only needed if you want the assistant to manage Cloudflare from
# inside the container (the initial setup uses these from your shell).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
